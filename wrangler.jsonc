{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcfcbot-legal",
  "compatibility_date": "2026-09-18",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
